{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-spotifyAzurePoject"
		},
		"azzuresql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'azzuresql'"
		},
		"dataLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'dataLake'"
		},
		"azzuresql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azureproject-server.database.windows.net"
		},
		"azzuresql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "spotifyProjectDB"
		},
		"azzuresql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "rbaaiAd"
		},
		"dataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagespotifyproject2.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-spotifyAzurePoject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"azzuresql_password": {
						"value": "[parameters('azzuresql_password')]"
					},
					"dataLake_accountKey": {
						"value": "[parameters('dataLake_accountKey')]"
					},
					"azzuresql_properties_typeProperties_server": {
						"value": "[parameters('azzuresql_properties_typeProperties_server')]"
					},
					"azzuresql_properties_typeProperties_database": {
						"value": "[parameters('azzuresql_properties_typeProperties_database')]"
					},
					"azzuresql_properties_typeProperties_userName": {
						"value": "[parameters('azzuresql_properties_typeProperties_userName')]"
					},
					"dataLake_properties_typeProperties_url": {
						"value": "[parameters('dataLake_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}